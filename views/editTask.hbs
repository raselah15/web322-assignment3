<h2>Edit Task</h2>

{{#if error}}
<p style="color:red;">{{error}}</p>
{{/if}}

<form method="POST" action="/tasks/edit/{{task.id}}">

    <label for="title">Title</label><br>
    <input
        type="text"
        id="title"
        name="title"
        value="{{task.title}}"
        required
    ><br><br>

    <label for="description">Description</label><br>
    <textarea
        id="description"
        name="description"
        rows="4"
        cols="40"
    >{{task.description}}</textarea><br><br>

    <label for="dueDate">Due Date</label><br>
    <input
        type="date"
        id="dueDate"
        name="dueDate"
        value="{{task.dueDate}}"
    ><br><br>

    <label>
        <input
            type="checkbox"
            name="status"
            {{#if (eq task.status "completed")}}checked{{/if}}
        >
        Completed
    </label>

    <br><br>

    <button type="submit">Update Task</button>

</form>

<br>

<a href="/tasks">Back to Tasks</a>

